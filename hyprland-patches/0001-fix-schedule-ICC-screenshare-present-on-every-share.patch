From af2108c04a41440ef3273a597a5b16dffaf29fa5 Mon Sep 17 00:00:00 2001
From: Chris Olin <chris@chrisolin.com>
Date: Sun, 13 Sep 2026 13:46:45 -0400
Subject: [PATCH] fix: schedule ICC screenshare present on every share

ext-image-copy-capture only called scheduleFrame/damageMonitor when
m_isFirst. wlr-screencopy damages the monitor on each share. On headless
outputs (e.g. Miracast Extend) that left a stale framebuffer until an
unrelated present such as pointer motion, so typed glyphs appeared to
buffer until the mouse moved.

Always schedule a frame and damage the monitor when sharing, matching
wlr-screencopy. Also guard damageMonitor with a PMONITOR null-check.
---
 src/managers/screenshare/ScreenshareFrame.cpp | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/src/managers/screenshare/ScreenshareFrame.cpp b/src/managers/screenshare/ScreenshareFrame.cpp
index c77f8bcf..3e9d7787 100644
--- a/src/managers/screenshare/ScreenshareFrame.cpp
+++ b/src/managers/screenshare/ScreenshareFrame.cpp
@@ -125,12 +125,15 @@ eScreenshareError CScreenshareFrame::share(SP<IHLBuffer> buffer, const CRegion&
             PMONITOR->addDamage(PMONITOR->resources()->pendingMirrorFBDamage());
     }
 
-    // schedule a frame so that when a screenshare starts it isn't black until the output is updated
-    if (m_isFirst) {
+    // Always schedule a present. wlr-screencopy damages every share; ICC used
+    // to only do this when m_isFirst, which stalls headless outputs (e.g. Miracast)
+    // until an unrelated present such as pointer motion.
+    {
         const auto PMONITOR = m_session->monitor();
-        if (PMONITOR)
+        if (PMONITOR) {
             PMONITOR->scheduleFrame(Aquamarine::IOutput::AQ_SCHEDULE_NEEDS_FRAME);
-        g_pHyprRenderer->damageMonitor(PMONITOR);
+            g_pHyprRenderer->damageMonitor(PMONITOR);
+        }
     }
 
     // TODO: add a damage ring for output damage since last shared frame
